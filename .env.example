# Local: python3 scripts/bootstrap.py creates a separate .env and password file.
HCC_ADMIN_USER=admin
HCC_ENABLE_SSH=false
HCC_SEED_DEMO=true
HCC_POLL_SECONDS=30
# Production public HTTPS origin, including the actual custom port.
# Set only after the deployment address is confirmed.
HCC_PUBLIC_ORIGIN=https://console.example.com:8443
HCC_HTTPS_PORT=8443
HCC_BIND_ADDRESS=127.0.0.1
